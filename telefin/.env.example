# TeleFin configuration.
# Copy this file to .env first:   cp .env.example .env

# Find from https://my.telegram.org → "API development tools".
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Find chat ID from https://t.me/userinfobot on Telegram.
ALLOWED_USERS=123456789

# Where downloaded files land. Sonarr/Radarr must see this SAME path.
DOWNLOAD_DIR=/srv/media/incoming

# API keys are under Settings → General in each app.
# Leave blank if dont want to integrate
SONARR_URL=http://localhost:8989
SONARR_API_KEY=YOUR_SONARR_API_KEY

RADARR_URL=http://localhost:7878
RADARR_API_KEY=YOUR_RADARR_API_KEY

# Where to watch for incoming files. Comma-separated; any mix of:
#   me                 -> your own Saved Messages (default)
#   -1001234567890     -> a group/channel by numeric ID (allowed users post here)
#   @somegroup         -> a public group/channel username
# Example (watch both your Saved Messages AND a group):
#   WATCH_CHAT=me,-1001234567890
# Senders are still filtered by ALLOWED_USERS, so only trusted people trigger
# downloads even in a shared group.
WATCH_CHAT=me

# Session file name (created on first login). Docker overrides this.
SESSION_NAME=userbot_session

# How many files to download at once. 1 keeps bandwidth predictable.
MAX_CONCURRENT_DOWNLOADS=1

# Seconds between Telegram progress edits (Telegram rate-limits edits).
PROGRESS_INTERVAL=5

# Allowed extensions (comma separated).
# ALLOWED_EXTENSIONS=mkv,mp4,avi,mov,wmv,flv,webm,m4v

# SQLite database file (stores queue + history). Docker overrides this.
DB_PATH=telefin.db

# --- Web dashboard -------------------------------------------------------
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8420

# HTTP Basic auth for the dashboard. Set BOTH to enable; leave blank
# for open, LAN-only use.
WEB_USERNAME=
WEB_PASSWORD=

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
