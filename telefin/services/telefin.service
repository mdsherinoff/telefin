[Unit]
Description=TeleFin - Telegram to Sonarr/Radarr/Jellyfin bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/telefin/telefin
ExecStart=/opt/telefin/telefin/venv/bin/python main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
