# TeleFin configuration.
# Copy this file to .env first:   cp .env.example .env

# Find from https://my.telegram.org → "API development tools".
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Find chat ID from https://t.me/userinfobot on Telegram.
ALLOWED_USERS=123456789

# Where downloaded files land. Sonarr/Radarr must see this SAME path.
# Used as the fallback whenever DOWNLOAD_DIR_MOVIES / DOWNLOAD_DIR_TV
# (below) aren't set.
DOWNLOAD_DIR=/srv/media/incoming

# Optional: split movies and TV downloads onto separate paths (e.g. two
# different drives/mounts, one per Sonarr/Radarr library root). When set,
# these take priority over DOWNLOAD_DIR for their media type. Point each
# at a path on the SAME filesystem as the matching *arr library root so
# the post-download import is an instant rename instead of a cross-disk
# copy. Leave both blank to keep using a single DOWNLOAD_DIR.
# DOWNLOAD_DIR_MOVIES=/media/Movies/incoming
# DOWNLOAD_DIR_TV=/media/TVShows/incoming

# API keys are under Settings → General in each app.
# Leave blank if dont want to integrate
SONARR_URL=http://localhost:8989
SONARR_API_KEY=YOUR_SONARR_API_KEY

RADARR_URL=http://localhost:7878
RADARR_API_KEY=YOUR_RADARR_API_KEY

# The Sonarr/Radarr scan trigger on download completion is fire-and-forget:
# if the title wasn't requested through Seerr/Overseerr, Sonarr/Radarr just
# ignores it and the file sits in the incoming folder untouched. TeleFin
# periodically re-announces any completed download whose file is still at
# its download path (a successful import moves the file away, so "still
# there" means "not picked up yet"). Set to 0 to disable; you can always
# re-notify a single item manually from the web dashboard.
NOTIFY_INTERVAL_MINUTES=60

# Where to watch for incoming files. Comma-separated; any mix of:
#   me                 -> your own Saved Messages (default)
#   -1001234567890     -> a group/channel by numeric ID (allowed users post here)
#   @somegroup         -> a public group/channel username
# Example (watch both your Saved Messages AND a group):
#   WATCH_CHAT=me,-1001234567890
# Senders are still filtered by ALLOWED_USERS, so only trusted people trigger
# downloads even in a shared group.
WATCH_CHAT=me

# Session file name (created on first login). Docker overrides this.
SESSION_NAME=userbot_session

# How many files to download at once. 1 keeps bandwidth predictable.
MAX_CONCURRENT_DOWNLOADS=1

# Seconds between Telegram progress edits (Telegram rate-limits edits).
PROGRESS_INTERVAL=5

# How many times to retry a failed download (network blips etc.) before
# giving up and marking it failed. Backoff doubles each attempt, starting
# at RETRY_BACKOFF_SECONDS.
MAX_DOWNLOAD_RETRIES=3
RETRY_BACKOFF_SECONDS=10

# Allowed extensions (comma separated).
# ALLOWED_EXTENSIONS=mkv,mp4,avi,mov,wmv,flv,webm,m4v

# SQLite database file (stores queue + history). Docker overrides this.
DB_PATH=telefin.db

# Automatically delete finished download records (completed/failed/skipped/
# cancelled) older than this many days, checked once a day. Only prunes
# history rows, never touches files on disk. 0 disables (default: keep
# history forever).
RETENTION_DAYS=0

# --- Web dashboard -------------------------------------------------------
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8420

# HTTP Basic auth for the dashboard. Set BOTH to enable; leave blank
# for open, LAN-only use.
WEB_USERNAME=
WEB_PASSWORD=

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# Optional: also write logs to a file with rotation, on top of stdout.
# Mainly useful for bare (non-Docker) deployments where stdout isn't
# already captured by something with its own rotation (journald, Docker's
# log driver). Leave blank to log to stdout only.
# LOG_FILE=/config/telefin.log
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5
